# Claude: by default the bot uses your Claude subscription through the `claude` CLI (run `claude` then /login once).
# Set LLM_BACKEND=api to use a paid API key instead.
LLM_BACKEND=cli
ANTHROPIC_API_KEY=
# Optional sources
REED_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Set to open the dashboard to your phone on the same Wi-Fi (http://<mac-name>.local:4319/?t=TOKEN)
DASHBOARD_TOKEN=
PORT=4319
# HEADED=1 shows the browser while it fills forms
HEADED=
