{
  "name": "jobfinder-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "discover": "tsx --env-file-if-exists=.env src/cli.ts discover",
    "score": "tsx --env-file-if-exists=.env src/cli.ts score",
    "prep": "tsx --env-file-if-exists=.env src/cli.ts prepare",
    "run-all": "tsx --env-file-if-exists=.env src/cli.ts run",
    "login": "tsx --env-file-if-exists=.env src/cli.ts login",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "mammoth": "^1.13.0",
    "node-cron": "^4.6.0",
    "playwright": "^1.64.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}